# ==============================
# OpsPulse - Global Git Ignore
# ==============================

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# FastAPI / backend
*.sqlite
*.sqlite3

# Android / Gradle
.gradle/
build/
*/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Android signing
*.keystore
*.jks

# Test / coverage
coverage/
htmlcov/
.pytest_cache/
coverage.xml

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Generated artifacts
dist/
out/
artifacts/

# Local OpsPulse data
.local/
